# Copy to .env.local and fill in. Never commit a file with real values.

# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Safe to ship in the browser bundle. RLS and the EXECUTE revokes in migrations
# 037/040 are what keep it harmless.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-only, bypasses RLS entirely. Used by /api/rpc and
# /api/upload/sign to act on behalf of the session user. Required: without it
# every mutation fails once migration 037 is applied.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Database
# SECRET. Direct Postgres connection for the NextAuth credentials provider.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional: PEM of a private CA, when the database is not using a public CA.
# DATABASE_CA_CERT=
# Escape hatch only. Encrypts but does not authenticate the connection.
# DATABASE_SSL_NO_VERIFY=false

# ---------------------------------------------------------------- Auth
# SECRET. Signs session JWTs; anyone holding it can mint a session for any user.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- Cron
# SECRET. Shared bearer token for /api/cron/refresh-trending. The route refuses
# to run unless this is set.
CRON_SECRET=

# ---------------------------------------------------------------- Pitch mode
# Set to true for the creative-web product surface. Parks /feed, /spotlight,
# /messages, etc. behind redirects to /. Login/signup/profile stay open —
# guests can upload/comment/like; signed-in users post as their account.
# Content still writes to the same DB — set false and redeploy to restore
# the full app with seeded posts intact.
# Seed genre hubs first: npm run seed:genres
# Optional public-domain art fill: npm run seed:public-domain
NEXT_PUBLIC_PITCH_MODE=false
